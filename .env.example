# PeptideProspect AI - Environment Configuration
# Copy this file to .env and fill in your values

# Server port (Render uses 10000 by default)
PORT=10000

# OpenAI API Key for AI response generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# SQLite database path (/tmp is writable on Render free tier)
DB_PATH=/tmp/peptide.db
